# Server Configuration
WHISPER_MODEL=small
DEVICE=cpu
COMPUTE_TYPE=int8
MAX_UPLOAD_SIZE_MB=50
HF_TOKEN=
LLM_URL=
CACHE_DIR=/root/.cache/huggingface

# Installation:
#   uv sync --extra cpu          (CPU/Intel default)
#   For NVIDIA GPU, edit pyproject.toml and change the
#   pytorch-cpu index URL to https://download.pytorch.org/whl/cu121,
#   then run: uv sync --extra cu121
#
# Docker:
#   CPU:  docker build server/
#   GPU:  docker build server/ --build-arg BASE_IMAGE=nvidia/cuda:12.3.2-cudnn9-runtime-ubuntu22.04 --build-arg PYTORCH_INDEX=https://download.pytorch.org/whl/cu121
#
# Hardware presets:
# CPU (Intel/AMD):
#   WHISPER_MODEL=small
#   DEVICE=cpu
#   COMPUTE_TYPE=int8
#
# NVIDIA GPU (CUDA 12.1):
#   WHISPER_MODEL=large-v3-turbo
#   DEVICE=cuda
#   COMPUTE_TYPE=float16
#   HF_TOKEN=your_huggingface_read_token
