# Server Configuration
WHISPER_MODEL=small
DEVICE=cpu
COMPUTE_TYPE=int8
MAX_UPLOAD_SIZE_MB=50
HF_TOKEN=
LLM_URL=
CACHE_DIR=/root/.cache/huggingface

# Hardware presets:
# CPU (Intel/AMD):
#   WHISPER_MODEL=small
#   DEVICE=cpu
#   COMPUTE_TYPE=int8
#
# NVIDIA GPU:
#   WHISPER_MODEL=large-v3-turbo
#   DEVICE=cuda
#   COMPUTE_TYPE=float16
#   HF_TOKEN=your_huggingface_read_token
